<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TÍTULO -->
        <TextView
            android:id="@+id/txtTituloFragment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Consumo de Luz"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/morado_principal"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Carga tu recibo de luz en formato PDF para analizar el consumo."
            android:textSize="16sp"/>

        <!-- RECIBO PDF -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="15dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recibo de Luz"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@color/morado_principal"/>

                <Button
                    android:id="@+id/btnSeleccionarPDF"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:backgroundTint="@color/morado_principal"
                    android:text="SELECCIONAR RECIBO PDF"/>

                <TextView
                    android:id="@+id/txtArchivo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="Ningún archivo seleccionado"
                    android:textStyle="italic"/>

                <Button
                    android:id="@+id/btnAnalizar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:backgroundTint="@color/verde_lima"
                    android:text="ANALIZAR RECIBO"/>

                <ProgressBar
                    android:id="@+id/progressAnalisis"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:visibility="gone"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- RESULTADOS -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardResultados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="15dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- TÍTULO DE RESULTADOS -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Resultados del análisis"
                    android:textColor="@color/morado_principal"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <!-- CONSUMO -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Consumo (kWh)"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtConsumo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 kWh"
                    android:textColor="@color/verde_lima"
                    android:textSize="18sp"/>

                <!-- PERIODO -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="Periodo"
                    android:textStyle="bold"
                    android:textColor="@color/morado_principal"/>

                <!-- FECHA DE INICIO -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Fecha de inicio"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtInicio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--/--/----"/>

                <!-- FECHA DE FIN -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Fecha de fin"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtFin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--/--/----"/>

                <!-- TOTAL PAGADO -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Total pagado"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtPago"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$0.00"/>

                <!-- TARIFA -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Tarifa"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtTarifa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No disponible"/>

                <!-- GUARDAR -->
                <Button
                    android:id="@+id/btnGuardar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:backgroundTint="@color/morado_principal"
                    android:text="GUARDAR INFORMACIÓN"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>