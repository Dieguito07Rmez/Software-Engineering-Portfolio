<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TÍTULO -->

        <TextView
            android:id="@+id/txtTituloFragment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Electrodomésticos"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/morado_principal"/>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Registra los electrodomésticos de tu hogar para estimar el consumo de energía."
            android:textSize="16sp"/>


        <!-- FORMULARIO -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="15dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">


                <!-- TIPO -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tipo de electrodoméstico"
                    android:textStyle="bold"/>


                <Spinner
                    android:id="@+id/spElectrodomestico"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>


                <!-- MARCA -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Marca"
                    android:textStyle="bold"/>


                <EditText
                    android:id="@+id/edtMarca"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ej. Samsung"
                    android:inputType="textCapWords"/>


                <!-- VOLTAJE -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Voltaje (V)"
                    android:textStyle="bold"/>


                <EditText
                    android:id="@+id/edtVoltaje"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="127"
                    android:inputType="number"/>


                <!-- POTENCIA -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Potencia (Watts)"
                    android:textStyle="bold"/>


                <EditText
                    android:id="@+id/edtPotencia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="150"
                    android:inputType="number"/>


                <!-- CANTIDAD -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Cantidad"
                    android:textStyle="bold"/>


                <Spinner
                    android:id="@+id/spCantidad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>


                <!-- HORAS -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Horas de uso por día"
                    android:textStyle="bold"/>


                <EditText
                    android:id="@+id/edtHoras"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="8"
                    android:inputType="numberDecimal"/>


                <!-- GUARDAR -->

                <Button
                    android:id="@+id/btnGuardar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="@color/morado_principal"
                    android:text="GUARDAR"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- LISTA -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="15dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Electrodomésticos registrados"
                    android:textStyle="bold"
                    android:textColor="@color/morado_principal"
                    android:textSize="18sp"/>


                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvElectrodomesticos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>